{
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": ["airbnb-base"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "quotes": ["error", "double", { "allowTemplateLiterals": true }],
    "no-underscore-dangle": ["error", { "allow": ["_id"] }],
    "max-len": ["off"]
  }
}
